{
  "name": "voiceshield",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-dev-ports.mjs && concurrently -k -n proxy,web -c blue,green \"npm run dev:proxy\" \"npm run dev:web\"",
    "dev:web": "vite --host",
    "dev:proxy": "tsx server/proxy.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve:python": "python serve.py"
  },
  "dependencies": {
    "@speechmatics/browser-audio-input": "^2.0.4",
    "@speechmatics/browser-audio-input-react": "^2.0.4",
    "@speechmatics/real-time-client-react": "^3.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.4",
    "globals": "^16.5.0",
    "tsx": "^4.23.8",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0"
  }
}
