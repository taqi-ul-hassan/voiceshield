# .dockerignore — exclude files from the Docker build context.
# Keep the context small and prevent secrets from leaking into the image.

# Development state
node_modules/
dist-ssr/
*.local

# Secrets — NEVER in the image
.env
.env.*
!.env.example

# Test artefacts
tests/__pycache__/
.pytest_cache/
__pycache__/
*.pyc

# Editor / OS noise
.vscode/
.idea/
.DS_Store
*.suo
*.sw?

# CI
.github/

# Playwright
.playwright-cli/
playwright-report/
test-results/

# Promotion assets (large; not needed at runtime)
promotions/

# Docs (not needed at runtime)
*.md
LICENSE
TODO_LIST/
