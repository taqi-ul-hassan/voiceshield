# VoiceShield BFF proxy — server-side ONLY. These are read by server/proxy.ts
# and never shipped to the browser. Copy this file to `.env`, fill in real
# values, and keep `.env` out of version control (it is gitignored).

# ── Quick start for demos, judges, and customers ────────────────────────────
# You do NOT need to touch this file. Open the app → Settings → Provider keys
# and paste your AIML / Speechmatics keys there. Pasted keys are held in the
# proxy's memory for the session (up to 6 hours) and are never written to
# disk, localStorage, or shown back to the browser. Environment keys below are
# simply the optional, persistent alternative for production deployments.

# AIML API keys (used for AI evaluation + agent simulation via /api/aiml/chat).
# You can provide a comma-separated POOL of keys — the proxy rotates through
# them automatically (see KEY_ROTATION_INTERVAL below) and on manual rotation
# from Settings. The legacy single-key var AIML_API_KEY still works (one-key pool).
AIML_API_KEYS=

# Speechmatics API keys (used for realtime transcription JWTs + TTS via the proxy).
# Same pool semantics as AIML_API_KEYS; the legacy SPEECHMATICS_API_KEY still works.
SPEECHMATICS_API_KEYS=

# ── Key rotation ─────────────────────────────────────────────────────────────
# How often the proxy advances to the next key in a pool (e.g. 30m, 6h, 1d).
# Default: 6h. Only applies when a provider has 2+ keys in its pool.
KEY_ROTATION_INTERVAL=6h

# Consecutive upstream failures with the active key before it is rotated
# automatically (health-based rotation). Default: 3. Set to 0 to disable.
KEY_ROTATION_FAILURE_THRESHOLD=3

# Optional: session keys pasted from Settings → Provider keys expire after this
# TTL and fall back to the server pool. Default: 6h.
# RUNTIME_KEY_TTL=6h

# Port the BFF proxy listens on (default 8787)
PROXY_PORT=8787

# Optional: override the AIML chat completions URL
# AIML_API_URL=https://api.aimlapi.com/v1/chat/completions

# Optional: override the Speechmatics TTS base URL
# SPEECHMATICS_TTS_URL=https://preview.tts.speechmatics.com

# Optional: comma-separated extra origins allowed to call the proxy (CORS)
# ALLOWED_ORIGINS=https://voiceshield.example.com
